# Local development only. Keep the database port loopback-bound.
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_local_only
POSTGRES_DB=forge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://forge:forge_local_only@127.0.0.1:5432/forge
# Uncomment when using a different web origin. Production requires an HTTPS origin.
# WEB_ORIGIN=http://localhost:3000

# Local integrations. Mock mail is always disabled in production.
# FORGE_MAIL_MODE=mock
# FORGE_MOCK_MAIL_DIR=/absolute/private/path
