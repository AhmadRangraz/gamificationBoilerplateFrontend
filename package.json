{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node tooling/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tooling/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run build --filter=@forge/config && vitest run",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "pnpm --filter @forge/api db:migrate",
    "contract:generate": "turbo run build --filter=@forge/api && node tooling/contract.mjs",
    "contract:check": "turbo run build --filter=@forge/api && node tooling/contract.mjs --check",
    "forge": "node tooling/forge.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
