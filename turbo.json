{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["forge.config.ts", "tsconfig.base.json"],
  "tasks": {
    "generate": {
      "cache": false,
      "passThroughEnv": [
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "NO_PROXY",
        "https_proxy",
        "http_proxy",
        "no_proxy",
        "NODE_EXTRA_CA_CERTS",
        "SSL_CERT_FILE",
        "SSL_CERT_DIR"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@forge/api#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@forge/web#build": {
      "dependsOn": ["^build"],
      "env": ["FORGE_API_ORIGIN"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "@forge/api#typecheck": { "dependsOn": ["^build", "generate"] },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "FORGE_API_ORIGIN"
      ]
    },
    "@forge/api#dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "WEB_ORIGIN",
        "FORGE_MAIL_MODE",
        "FORGE_MOCK_MAIL_DIR"
      ]
    }
  }
}
